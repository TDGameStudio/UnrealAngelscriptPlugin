{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win64-msvc",
      "displayName": "Win64 MSVC standalone",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/win64-msvc",
      "cacheVariables": {
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release",
        "BUILD_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win64-msvc-debug",
      "configurePreset": "win64-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win64-msvc-release",
      "configurePreset": "win64-msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "win64-msvc-debug",
      "configurePreset": "win64-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win64-msvc-release",
      "configurePreset": "win64-msvc",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
